Container_Boundary(service, "Интеграция с устройствами / Java 21 / Spring Framework / JVM-процесс") {
Component(consumer, "Command / Lifecycle Consumer", "Spring AMQP / Java 21", "Дедупликация AMQP; команды в dispatch, события регистрации в provisioning.")
