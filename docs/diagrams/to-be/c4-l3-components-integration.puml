Rel(mqtt, ingress, "Измерения, state, ACK, bootstrap", "MQTT / TLS")
Rel(ingress, provision, "Проверка challenge-ответа", "")
Rel(ingress, adapters, "Декодирование известной схемы", "")
Rel(adapters, normalizer, "Данные внутренней модели", "")
Rel(normalizer, repo, "Результат / измерение + outbox", "")
Rel(publisher, repo, "Чтение outbox", "")
