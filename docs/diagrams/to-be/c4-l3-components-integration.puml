Component(normalizer, "EventNormalizer", "Spring Framework / Java 21", "Нормализует telemetry/state/ACK; назначает envelope; проверяет correlation и sequence.")
Component(repo, "IntegrationRepository", "Spring JDBC / Spring TX", "dispatch, bootstrap/provisioning, привязки соединений, inbox/outbox.")
Component(publisher, "OutboxPublisher", "Spring AMQP / Scheduling", "Результаты, нормализованные измерения и lifecycle ACK после commit.")
}
