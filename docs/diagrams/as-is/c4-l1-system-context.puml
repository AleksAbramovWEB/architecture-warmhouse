@startuml c4-l1-system-context
!pragma layout smetana
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()

title Тёплый дом — As-Is — C4 L1 / System Context: контекст системы

Person(resident, "Пользователь", "Пользуется веб-интерфейсом: управляет отоплением и смотрит температуру в доме.")
Person(installer, "Специалист по подключению", "Выезжает в дом для установки и подключения оборудования.")

System(warmhouse, "Тёплый дом", "Монолитная система удалённого управления отоплением и просмотра текущей температуры.")

System_Ext(heating, "Модуль управления отоплением", "Оборудование в доме. Исполняет команды включения и выключения отопления.")
System_Ext(sensor, "Датчик температуры", "Оборудование в доме. Возвращает показание в ответ на запрос сервера.")

Rel(resident, warmhouse, "Включает/выключает отопление и запрашивает текущую температуру через веб-интерфейс")
Rel_D(warmhouse, heating, "Синхронно отправляет команды включения/выключения")
Rel_D(warmhouse, sensor, "Синхронно запрашивает температуру; получает измерение в ответ")
Rel(installer, heating, "Устанавливает и подключает в доме")
Rel(installer, sensor, "Устанавливает и подключает в доме")

SHOW_LEGEND()
@enduml
